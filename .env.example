# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Secret used to sign and verify JWT tokens. Set a long random string in production.
# Falls back to a hardcoded dev default if not set — always set this in production.
JWT_SECRET=change_me_in_production

# Postgres credentials (used by both the db and api containers).
POSTGRES_DB=weather_predictor
POSTGRES_USER=weather
POSTGRES_PASSWORD=change_me_in_production

# Host ports for each service.
# Change any of these if the default clashes with something already running on your machine.
PORT_WEB=3000
PORT_API=4000
PORT_DB=5432
PORT_PROMETHEUS=9091
PORT_GRAFANA=3001
