# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Required for the Google Maps location search in the frontend.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Secret used to sign and verify JWT tokens. Set a long random string in production.
# Falls back to a hardcoded dev default if not set — always set this in production.
JWT_SECRET=change_me_in_production

# Postgres credentials (used by both the db and api containers).
POSTGRES_DB=weather_predictor
POSTGRES_USER=weather
POSTGRES_PASSWORD=change_me_in_production
